{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "client/build"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/products",
      "dest": "api/index.js"
    },
    {
      "src": "/images/(.*)",
      "dest": "server/public/images/$1"
    },
    {
      "src": "/(.*)",
      "dest": "client/build/$1"
    }
  ]
}
